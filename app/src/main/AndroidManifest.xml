<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Declare camera as non-required so app can install on ChromeOS/large screens -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".VaultApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_fix_black"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_fix_black_round"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.TheVault">
        
        <!-- Primary Launcher Activity -->
        <activity
            android:name="com.vault.srd.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:theme="@style/Theme.TheVault">
        </activity>

        <activity-alias
            android:name=".VaultBlackAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_fix_black"
            android:roundIcon="@mipmap/ic_launcher_fix_black_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".VaultWhiteAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_fix_white"
            android:roundIcon="@mipmap/ic_launcher_fix_white_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".VaultGrayAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_fix_gray"
            android:roundIcon="@mipmap/ic_launcher_fix_gray_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Stealth Disguise Aliases -->
        <activity-alias
            android:name=".AssistantAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_stealth_assistant"
            android:roundIcon="@mipmap/ic_stealth_assistant_round"
            android:label="Voice Assistant"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".CloudAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_stealth_cloud"
            android:roundIcon="@mipmap/ic_stealth_cloud_round"
            android:label="Cloud Storage"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".PodcastsAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_stealth_podcasts"
            android:roundIcon="@mipmap/ic_stealth_podcasts_round"
            android:label="Podcasts"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".GoogleAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_stealth_google"
            android:roundIcon="@mipmap/ic_stealth_google_round"
            android:label="Google"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        
    </application>

</manifest>
